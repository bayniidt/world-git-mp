    "@tarojs/cli": "3.6.31",
    "@tarojs/plugin-framework-react": "3.6.31",
    "@tarojs/webpack5-runner": "3.6.31",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/parser": "^5.x",
    "autoprefixer": "^10.4.23",
